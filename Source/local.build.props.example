<Project>
  <!-- Copy this file to local.build.props (gitignored) and set the path to YOUR RimWorld install.
       The mod references the game's DLLs from <RimWorldDir>\RimWorldWin64_Data\Managed\. -->
  <PropertyGroup>
    <RimWorldDir>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
  </PropertyGroup>
</Project>
